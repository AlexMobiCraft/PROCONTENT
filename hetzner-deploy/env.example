############
# Параметры сервера
############

POSTGRES_PASSWORD=ChangeThisStrongPassword123!
JWT_SECRET=ChangeThisJWTSecret12345678901234567890123456789012
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiJ9.ZopQoOw-A7Xl7kJxZYg9H9Xc-TDiAwP7P_HsY1b-4GI
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIn0.MqIhFOyLqNWc8qmqHCVI1qWEDn7dYBL5nOnaLxr8f4E
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=ChangeThisDashboardPassword123!

############
# База данных
############

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres

############
# Публичные URL
############

# API — публичный домен Supabase (Kong за nginx)
API_EXTERNAL_URL=https://api.procontent.si
SUPABASE_PUBLIC_URL=https://api.procontent.si
# SITE_URL — домен фронтенда (приложение работает на www; без www → 307)
SITE_URL=https://www.procontent.si

############
# JWT и авторизация
############

JWT_EXPIRY=3600
SECRET_KEY_BASE=ChangeThisSecretKeyBase12345678901234567890123456789012

############
# Дополнительные настройки
############

ADDITIONAL_REDIRECT_URLS=https://www.procontent.si/**,https://procontent.si/**
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

############
# SMTP — Resend как relay
# ВНИМАНИЕ: порт 465 Hetzner блокирует → используем 587 (STARTTLS).
# SMTP_PASS = Resend API key (re_...). Домен отправителя должен быть
# верифицирован в Resend (DKIM/SPF на send.<domain>).
############

SMTP_ADMIN_EMAIL=noreply@procontent.si
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_YOUR_RESEND_API_KEY
SMTP_SENDER_NAME=ProContent
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

############
# Кастомные шаблоны писем GoTrue
# GOTRUE_MAILER_TEMPLATES_* принимает ТОЛЬКО HTTP(S)-URL. Шаблон отдаётся
# сервисом email-templates (nginx) по внутреннему docker-DNS.
# Файл шаблона: volumes/auth/templates/recovery.html
############

MAILER_SUBJECTS_RECOVERY=Ponastavitev gesla za PROCONTENT
MAILER_TEMPLATES_RECOVERY=http://email-templates/recovery.html
# VIP-приглашение. Файл шаблона: volumes/auth/templates/invite.html
MAILER_SUBJECTS_INVITE=Vabilo v klub PROCONTENT
MAILER_TEMPLATES_INVITE=http://email-templates/invite.html

############
# Storage и Realtime
############

STORAGE_TENANT_ID=default
GLOBAL_S3_BUCKET=default
REGION=local
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
IMGPROXY_AUTO_WEBP=true

############
# Pooler
############

POOLER_TENANT_ID=default
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=10
VAULT_ENC_KEY=ChangeThisVaultEncKey1234567890123456789012345678901

############
# PostgREST
############

PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# Analytics / Logflare
############

LOGFLARE_PUBLIC_ACCESS_TOKEN=ChangeThisLogflareToken12345678901234567890123456789012
LOGFLARE_PRIVATE_ACCESS_TOKEN=ChangeThisLogflarePrivateToken12345678901234567890123456789012
PG_META_CRYPTO_KEY=ChangeThisCryptoKey1234567890123456789012345678901234567890

############
# Edge Functions
############

FUNCTIONS_VERIFY_JWT=true
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION=ProContent
STUDIO_DEFAULT_PROJECT=ProContent
OPENAI_API_KEY=
